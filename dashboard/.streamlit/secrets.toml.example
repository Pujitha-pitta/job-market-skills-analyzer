# Copy this file to secrets.toml (same folder) and fill in your details.
# secrets.toml is git-ignored — never commit it.

[connections.snowflake]
account   = "abc12345.ap-south-1"      # or orgname-accountname
user      = "YOUR_USER"
password  = "YOUR_PASSWORD_OR_PAT"     # Programmatic Access Token if MFA is enforced
role      = "REPORTER"                 # read-only role created in 01_setup.sql
warehouse = "TRANSFORM_WH"
database  = "JOB_MARKET_DB"
schema    = "MARTS"
